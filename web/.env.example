# Sign-in through Privy (email codes and GitHub only). Copy to .env.local and fill in.
# Anyone who signs in with a verified email or GitHub account can use the dashboard.
# Privy only starts over HTTPS, or on localhost.

# Privy dashboard > App settings > Basics. The app id is 25 characters.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: Privy dashboard > App settings > Verification key (the PEM block, with \n for line breaks).
# Skips a key fetch on each sign-in. If it is wrong, every sign-in fails, so leave it empty when unsure.
PRIVY_VERIFICATION_KEY=

# Signs the session cookie. At least 32 characters, for example: openssl rand -base64 48
QUARD_SESSION_SECRET=

# 1 skips sign-in in development, for screenshots and local work. Production ignores it.
QUARD_SKIP_SIGN_IN=
