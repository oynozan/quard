# Copy this file to sandbox/.env and fill it in. sandbox/.env is never committed.
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.4-mini

# To send runs to the local dashboard (start it with: node sandbox/dashboard.ts).
# The hash key is 64 hex characters. Make one with: openssl rand -hex 32
# QUARD_HASH_KEY=
# Create the agent key in the dashboard: Settings > Create key
# QUARD_AGENT_KEY=
# QUARD_WEBHOOK_URL=http://localhost:4100
# QUARD_CONTROL_URL=http://localhost:4200
