# Copy this file to sandbox/.env and fill it in. sandbox/.env is never committed.
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.4-mini
# Optional: the playground's AI detector uses Jev with a TypeSafe key, else an OpenAI model
# TYPESAFE_API_KEY=

# To send runs to the local dashboard (webhook, control and the worker must run; see README.md).
# Create the agent key in the dashboard: Settings > Create key. It is the only Quard secret you need.
# QUARD_AGENT_KEY=
# QUARD_WEBHOOK_URL=http://localhost:4100
# QUARD_CONTROL_URL=http://localhost:4200
