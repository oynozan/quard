# Settings for compose.yaml. Copy to .env and fill in. Never commit .env.

# Postgres. Use letters and digits only, for example: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=quard
POSTGRES_DB=quard

# Hashes IBANs, cards and emails. 64 hex characters: openssl rand -hex 32
# Every agent process uses the same key. It never leaves your network.
QUARD_HASH_KEY=

# Dashboard sign-in through Privy (email codes and GitHub).
# Privy dashboard > App settings > Basics. The app id is 25 characters.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: Privy dashboard > App settings > Verification key, with \n for line breaks
PRIVY_VERIFICATION_KEY=

# Signs the dashboard session cookie. At least 32 characters: openssl rand -hex 32
QUARD_SESSION_SECRET=

# Optional: your own OpenAI key, for the AI reviewer and replay in the worker
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional: the project the dashboard shows. Empty means the first project.
QUARD_PROJECT_ID=

# Optional: ports on this machine
QUARD_WEB_PORT=3000
QUARD_WEBHOOK_PORT=4100
QUARD_CONTROL_PORT=4200
