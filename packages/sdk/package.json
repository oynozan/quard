{
    "name": "quard",
    "version": "0.0.0",
    "description": "Records every model call, stops dangerous actions before they run, and shows what caused a failure.",
    "type": "module",
    "license": "UNLICENSED",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "build": "tsdown",
        "test": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "schemas": "vitest run schemas --update"
    },
    "dependencies": {
        "tldts": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@quard/shared": "workspace:*",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "openai": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
